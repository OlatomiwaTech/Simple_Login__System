# Express runtime: local PostgreSQL in development, Neon pooled URL in production.
# Neon URLs should include its required SSL parameters.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Prisma CLI and migrations: direct/unpooled PostgreSQL URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
